{
  "name": "@aembit/edge-sdk-ts",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for the Aembit Edge API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18"
  }
}
