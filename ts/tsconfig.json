{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@aembit/edge-sdk": ["./src/index.ts"],
      "@aembit/edge-sdk/trust-providers/*": ["./src/trust-providers/*.ts"],
      "@aembit/edge-sdk/*": ["./src/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "examples/**/*.ts", "examples/**/*.d.ts", "vitest.config.ts"]
}
