{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "14 days",
  "separateMajorMinor": false,
  "pinDigests": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "dependencyDashboard": false,
  "packageRules": [
    {
      "matchPackageNames": [
        "typescript",
        "typescript-eslint",
        "@typescript-eslint/parser",
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/utils"
      ],
      "groupName": "TypeScript & ESLint Ecosystem (all versions)"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "NPM dependencies (all versions)"
    },
    {
      "matchManagers": ["pip_requirements", "pep621", "poetry", "pipenv"],
      "groupName": "Python dependencies (all versions)"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions (all versions)"
    }
  ]
}
