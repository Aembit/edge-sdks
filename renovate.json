{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "14 days",
  "separateMajorMinor": false,
  "pinDigests": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "groupName": null
  },
  "packageRules": [
    {
      "description": "Prevent Renovate from attempting to pin Docker digests on action inputs (e.g., renovate-version)",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate"
      ],
      "pinDigests": false
    },
    {
      "description": "Do not pin or update GitHub Actions or reusable workflows referenced by branch name (e.g., @main); always keep live branch reference",
      "matchManagers": [
        "github-actions"
      ],
      "matchCurrentValue": "/^main$/",
      "pinDigests": false
    },
    {
      "matchManagers": ["npm"],
      "groupName": "NPM dependencies (all versions)",
      "separateMajorMinor": false,
      "groupSingleUpdates": true
    },
    {
      "matchPackageNames": [
        "typescript",
        "/^@typescript-eslint//"
      ],
      "groupName": "TypeScript & ESLint Ecosystem (all versions)"
    },
    {
      "matchManagers": ["pip_requirements", "pep621", "poetry", "pipenv"],
      "groupName": "Python dependencies (all versions)"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions (all versions)"
    }
  ]
}
