{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "14 days",
  "separateMajorMinor": false,
  "pinDigests": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "dependencyDashboard": false,
  "vulnerabilityAlerts": {
    "groupName": null
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "groupName": "NPM dependencies (all versions)",
      "postUpgradeTasks": {
        "commands": ["cd ts && npx eslint 'src/**/*.ts' --fix"],
        "fileFilters": ["ts/src/**/*.ts"],
        "executionMode": "branch"
      }
    },
    {
      "matchPackageNames": [
        "typescript",
        "/^@typescript-eslint//"
      ],
      "groupName": "TypeScript & ESLint Ecosystem (all versions)"
    },
    {
      "matchManagers": ["pip_requirements", "pep621", "poetry", "pipenv"],
      "groupName": "Python dependencies (all versions)"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions (all versions)"
    }
  ]
}
