# Copy this file to scripts/deploy-ts-example-bundle-to-vm.env and fill in your values.
# Example:
#   cp ./scripts/deploy-ts-example-bundle-to-vm.env.example ./scripts/deploy-ts-example-bundle-to-vm.env
#   ./scripts/deploy-ts-example-bundle-to-vm.sh --config ./scripts/deploy-ts-example-bundle-to-vm.env

# Required:
DEPLOY_ARTIFACT=./ts/examples/aws-imds-ec2/dist/index.mjs
DEPLOY_HOST=ec2-xx-xx-xx-xx.compute.amazonaws.com
DEPLOY_USER=ubuntu
DEPLOY_REMOTE_DIR=~/aembit-examples/aws-imds-ec2

# Optional:
# DEPLOY_REMOTE_NAME=index.mjs
# DEPLOY_SSH_KEY=~/.ssh/your-key.pem
# DEPLOY_SSH_PORT=22
