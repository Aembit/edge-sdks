# Copy this file to scripts/deploy-ts-to-vm.env and fill in your values.
# Example:
#   cp ./scripts/deploy-ts-to-vm.env.example ./scripts/deploy-ts-to-vm.env
#   ./scripts/deploy-ts-to-vm.sh --config ./scripts/deploy-ts-to-vm.env

# Required:
DEPLOY_HOST=ec2-xx-xx-xx-xx.compute.amazonaws.com
DEPLOY_USER=ubuntu
DEPLOY_REMOTE_DIR=~/edge-sdks/ts

# Optional:
# DEPLOY_SSH_KEY=~/.ssh/your-key.pem
# DEPLOY_SSH_PORT=22
# DEPLOY_CLEAN_LOCAL=0
